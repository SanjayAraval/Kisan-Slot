# PostgreSQL connection string used by src/db.js (createPool).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisan

# If DATABASE_URL is not set, the pg driver falls back to these:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=kisan
